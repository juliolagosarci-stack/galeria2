:root {
    /* Paleta Principal: Azul Oscuro Deep Navy + Dorado Metálico */
    --bg-main: #061026;
    --bg-secondary: #0d1f3f;
    --bg-card: #14284d;
    --bg-glass: rgba(13, 31, 63, 0.85);
    
    --gold-primary: #fbbf24;
    --gold-hover: #f59e0b;
    --gold-light: #fef08a;
    --gold-border: rgba(251, 191, 36, 0.3);

    --text-light: #f8fafc;
    --text-muted: #94a3b8;
    --danger: #ef4444;
    
    --radius: 12px;
    --transition: all 0.3s ease;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

body {
    background-color: var(--bg-main);
    color: var(--text-light);
    line-height: 1.6;
    overflow-x: hidden;
}

/* Colores de Utilidad */
.text-gold {
    color: var(--gold-primary);
}
.gold-icon {
    color: var(--gold-primary);
}
.gold-hr {
    border: none;
    border-top: 1px solid var(--gold-border);
}

/* 1. NAVBAR */
.navbar {
    background-color: var(--bg-glass);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--gold-border);
    position: sticky;
    top: 0;
    z-index: 1000;
    padding: 0.8rem 1.5rem;
}

.nav-container {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

.logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.3rem;
    font-weight: 800;
}

.nav-menu {
    display: flex;
    gap: 1.5rem;
}

.nav-link {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    transition: var(--transition);
}

.nav-link:hover, .nav-link.active {
    color: var(--gold-primary);
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
}

.search-box {
    position: relative;
}

.search-box input {
    background: var(--bg-main);
    border: 1px solid var(--gold-border);
    color: var(--text-light);
    padding: 0.5rem 1rem 0.5rem 2.2rem;
    border-radius: 20px;
    outline: none;
    width: 200px;
    transition: var(--transition);
}

.search-box input:focus {
    width: 260px;
    border-color: var(--gold-primary);
}

.search-icon {
    position: absolute;
    left: 0.7rem;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    color: var(--gold-primary);
}

.mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    color: var(--text-light);
    font-size: 1.5rem;
    cursor: pointer;
}

/* BOTONES */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.2rem;
    border-radius: var(--radius);
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: var(--transition);
    text-decoration: none;
    font-size: 0.9rem;
}

.btn-gold {
    background: linear-gradient(135deg, var(--gold-primary), var(--gold-hover));
    color: #000;
}

.btn-gold:hover {
    box-shadow: 0 0 15px rgba(251, 191, 36, 0.4);
    transform: translateY(-2px);
}

.btn-outline-gold {
    background: transparent;
    border: 1px solid var(--gold-primary);
    color: var(--gold-primary);
}

.btn-outline-gold:hover {
    background: var(--gold-primary);
    color: #000;
}

.btn-secondary {
    background: var(--bg-card);
    color: var(--text-light);
}

.btn-danger {
    background: var(--danger);
    color: white;
}

.btn-lg {
    padding: 0.8rem 1.8rem;
    font-size: 1rem;
}

.btn-full {
    width: 100%;
    justify-content: center;
}

.icon-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.4rem;
    border-radius: 50%;
}

.icon-btn:hover {
    color: var(--gold-primary);
}

/* 2. HERO SECTION */
.hero-section {
    position: relative;
    padding: 6rem 1.5rem;
    text-align: center;
    background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-main) 100%);
    border-bottom: 1px solid var(--gold-border);
    overflow: hidden;
}

.hero-content {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}

.hero-badge {
    background: rgba(251, 191, 36, 0.1);
    color: var(--gold-primary);
    border: 1px solid var(--gold-border);
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1rem;
}

.hero-content h1 {
    font-size: 2.8rem;
    font-weight: 900;
    margin-bottom: 1rem;
    line-height: 1.2;
}

.hero-content p {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin-bottom: 2rem;
}

.hero-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
}

/* SECCIONES Y CONTENEDORES */
.section-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
}

.section-title {
    text-align: center;
    margin-bottom: 2.5rem;
}

.section-title h2 {
    font-size: 2rem;
}

.section-title p {
    color: var(--text-muted);
}

/* 3. CARRUSEL */
.carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.carousel-track-container {
    overflow: hidden;
    width: 100%;
    border-radius: var(--radius);
}

.carousel-track {
    display: flex;
    gap: 1.2rem;
    transition: transform 0.4s ease;
}

.carousel-card {
    min-width: 280px;
    height: 380px;
    border-radius: var(--radius);
    overflow: hidden;
    position: relative;
    border: 1px solid var(--gold-border);
    flex-shrink: 0;
}

.carousel-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.carousel-info {
    position: absolute;
    bottom: 0;
    inset-x: 0;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(6, 16, 38, 0.95), transparent);
}

.carousel-btn {
    background: var(--bg-card);
    border: 1px solid var(--gold-border);
    color: var(--gold-primary);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    cursor: pointer;
    position: absolute;
    z-index: 10;
}

.carousel-btn.prev { left: -20px; }
.carousel-btn.next { right: -20px; }

/* 4. CONTENT BLOCKS */
.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
}

.feature-card {
    background: var(--bg-secondary);
    border: 1px solid var(--gold-border);
    padding: 2rem;
    border-radius: var(--radius);
    text-align: center;
    transition: var(--transition);
}

.feature-card:hover {
    transform: translateY(-5px);
    border-color: var(--gold-primary);
}

.feature-icon {
    width: 48px;
    height: 48px;
    color: var(--gold-primary);
    margin-bottom: 1rem;
}

/* 5. GALERÍA & SIDEBAR */
.gallery-layout {
    display: flex;
    gap: 2rem;
}

.album-sidebar {
    width: 260px;
    background: var(--bg-secondary);
    border: 1px solid var(--gold-border);
    padding: 1.5rem;
    border-radius: var(--radius);
    height: fit-content;
}

.album-sidebar h3 {
    margin-bottom: 1rem;
    color: var(--gold-primary);
}

.album-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.album-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    cursor: pointer;
    color: var(--text-muted);
    transition: var(--transition);
}

.album-item:hover, .album-item.active {
    background: var(--bg-card);
    color: var(--gold-primary);
}

.badge-gold {
    background: rgba(251, 191, 36, 0.15);
    color: var(--gold-primary);
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    font-size: 0.8rem;
}

.gallery-main {
    flex: 1;
}

.gallery-header {
    margin-bottom: 1.5rem;
}

.photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.2rem;
}

.photo-card {
    background: var(--bg-secondary);
    border-radius: var(--radius);
    overflow: hidden;
    position: relative;
    border: 1px solid var(--gold-border);
    aspect-ratio: 1 / 1;
    cursor: pointer;
    transition: var(--transition);
}

.photo-card:hover {
    transform: scale(1.02);
    box-shadow: 0 8px 20px rgba(0,0,0,0.5);
}

.photo-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 16, 38, 0.9), transparent);
    opacity: 0;
    transition: var(--transition);
    display: flex;
    align-items: flex-end;
    padding: 1rem;
}

.photo-card:hover .photo-overlay {
    opacity: 1;
}

.empty-state {
    text-align: center;
    padding: 4rem;
    color: var(--text-muted);
}

.empty-state svg {
    width: 64px;
    height: 64px;
    margin-bottom: 1rem;
    color: var(--gold-primary);
}

/* 6. CALL TO ACTION (CTA) */
.cta-section {
    background: linear-gradient(135deg, var(--bg-secondary), #173266);
    border-y: 1px solid var(--gold-border);
    text-align: center;
    padding: 4rem 1.5rem;
}

.cta-content {
    max-width: 600px;
    margin: 0 auto;
}

.cta-content h2 {
    font-size: 2.2rem;
    margin-bottom: 0.8rem;
}

.cta-content p {
    color: var(--text-muted);
    margin-bottom: 1.8rem;
}

/* 7. FOOTER */
.footer {
    background: #020612;
    border-top: 1px solid var(--gold-border);
    padding: 3rem 1.5rem 1.5rem 1.5rem;
}

.footer-container {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
}

.footer-brand p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0.5rem;
}

.footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
}

.footer-links a {
    color: var(--text-muted);
    text-decoration: none;
}

.footer-copy {
    grid-column: 1 / -1;
    text-align: center;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,0.05);
    color: var(--text-muted);
    font-size: 0.85rem;
}

/* MODALES Y EDITOR */
.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(5px);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    padding: 1rem;
}

.modal.active { display: flex; }

.modal-content {
    background: var(--bg-secondary);
    border: 1px solid var(--gold-border);
    border-radius: var(--radius);
    width: 100%;
    max-width: 480px;
    overflow: hidden;
}

.modal-large {
    max-width: 1000px;
    height: 85vh;
}

.modal-header, .modal-footer {
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-body { padding: 1.5rem; }

.form-group input, .form-control {
    width: 100%;
    padding: 0.6rem 0.8rem;
    background: var(--bg-main);
    border: 1px solid var(--gold-border);
    color: var(--text-light);
    border-radius: 6px;
    margin-top: 0.4rem;
}

.image-editor-modal {
    height: 100%;
    display: flex;
    position: relative;
}

.modal-close-fixed {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    background: rgba(0,0,0,0.5);
}

.editor-layout {
    display: flex;
    width: 100%;
    height: 100%;
}

.preview-area {
    flex: 1;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
}

.preview-area img {
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
}

.editor-sidebar {
    width: 320px;
    background: var(--bg-secondary);
    border-left: 1px solid var(--gold-border);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
}

.filter-preset-buttons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
}

.btn-preset {
    padding: 0.4rem;
    background: var(--bg-main);
    border: 1px solid var(--gold-border);
    color: var(--text-light);
    border-radius: 6px;
    cursor: pointer;
}

.slider-group {
    display: flex;
    flex-direction: column;
    font-size: 0.8rem;
}

.slider-group input {
    accent-color: var(--gold-primary);
}

/* MEDIA QUERIES RESPONSIVAS */
@media (max-width: 900px) {
    .gallery-layout {
        flex-direction: column;
    }
    .album-sidebar {
        width: 100%;
    }
    .editor-layout {
        flex-direction: column;
    }
    .editor-sidebar {
        width: 100%;
        height: 50%;
    }
}

@media (max-width: 768px) {
    .mobile-toggle { display: block; }
    
    .nav-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--bg-secondary);
        flex-direction: column;
        padding: 1.5rem;
        border-bottom: 1px solid var(--gold-border);
    }

    .nav-menu.active { display: flex; }

    .hero-content h1 { font-size: 2rem; }
    .btn-text { display: none; }
    .search-box input { width: 140px; }
    .search-box input:focus { width: 160px; }
}